<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Both are used only by the updater process, never by the IME. See UpdateActivity
         and the README. They exist because sideloading has no update channel; they come
         out if this ever ships through a store. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <service
            android:name=".ime.T9ImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- An Android TV app with no launcher activity is invisible on the home screen,
             and this one is installed on its own, so it needs a way in. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.KeyCaptureActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- The words the user taught the keyboard, listed so they can be removed. A store of
             everything typed that cannot be inspected or emptied is the thing docs/00-overview
             §3.1 promises this project does not build. -->
        <activity
            android:name=".settings.WordsActivity"
            android:exported="false"
            android:label="@string/words_title" />

        <!-- Separate process on purpose: the component that handles keystrokes contains
             no networking code, and this is where that claim is enforced rather than
             merely asserted. -->
        <activity
            android:name=".update.UpdateActivity"
            android:exported="true"
            android:label="@string/update_name"
            android:process=":updater" />

    </application>

</manifest>
